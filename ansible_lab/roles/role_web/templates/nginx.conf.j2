# Generated automatically by Ansible for {{ env_name | upper }} environment
# Static deployment control script block

server {
    listen {{ nginx_listen_port }};
    server_name localhost;

    location / {
        proxy_pass http://127.0.0.1:{{ app_run_port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Advanced conditional environment branching logic
        {% if app_debug_mode == "True" %}
        add_header X-Deployment-Stage "STAGING-DEBUG-ACTIVE";
        add_header X-Backend-URL "{{ db_connection_url }}";
        {% else %}
        add_header X-Deployment-Stage "PRODUCTION-SECURE-STABLE";
        add_header X-Backend-Status "Shielded-Cluster";
        {% endif %}
    }
}
